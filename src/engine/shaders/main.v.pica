; whittle vertex shader
; v0 = position (3f), v1 = color (4f RGBA), v2 = uv (2f)

.fvec projection[4]

.constf ones(1.0, 1.0, 1.0, 1.0)
.alias  one  ones.xxxx

.out outpos position
.out outclr color
.out outtc0 texcoord0

.alias inpos v0
.alias inclr v1
.alias inuv  v2

.proc main
	; force w = 1
	mov r0.xyz, inpos
	mov r0.w,   one

	; outpos = projection * inpos
	dp4 outpos.x, projection[0], r0
	dp4 outpos.y, projection[1], r0
	dp4 outpos.z, projection[2], r0
	dp4 outpos.w, projection[3], r0

	mov outclr, inclr
	mov outtc0, inuv

	end
.end
